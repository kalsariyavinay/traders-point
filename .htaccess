<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /traders-point/
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [R=301,L]
</IfModule>

# Never expose .env, composer/npm manifests or the artisan entrypoint.
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan)$">
    Require all denied
</FilesMatch>

Options -Indexes
